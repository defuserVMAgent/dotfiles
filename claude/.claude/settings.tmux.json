{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX\" ] && tmux set-window-option -t \"$TMUX_PANE\" window-status-style 'bg=#ff9e64,fg=#000000' 2>/dev/null; true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX\" ] && tmux set-window-option -t \"$TMUX_PANE\" window-status-style 'bg=#ff9e64,fg=#000000' 2>/dev/null; true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX\" ] && tmux set-window-option -t \"$TMUX_PANE\" window-status-style 'bg=#f7768e,fg=#000000' 2>/dev/null; true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX\" ] && tmux set-window-option -u -t \"$TMUX_PANE\" window-status-style 2>/dev/null; true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX\" ] && tmux set-window-option -u -t \"$TMUX_PANE\" window-status-style 2>/dev/null; true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX\" ] && tmux set-window-option -u -t \"$TMUX_PANE\" window-status-style 2>/dev/null; true"
          }
        ]
      }
    ]
  }
}
