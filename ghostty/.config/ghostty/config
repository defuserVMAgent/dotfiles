# Font configuration
font-size = 13

# Window padding (migrated from the old App Support config)
window-padding-x = 14
window-padding-y = 14

keybind = f11=toggle_fullscreen

# Color scheme from omarchy theme (tokyonight night). For Catppuccin Mocha,
# replace this whole block with:  theme = Catppuccin Mocha  +  background = 181825
background = 1a1b26
foreground = a9b1d6

# Normal colors
palette = 0=#32344a
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#ad8ee6
palette = 6=#449dab
palette = 7=#787c99

# Bright colors
palette = 8=#444b6a
palette = 9=#ff7a93
palette = 10=#b9f27c
palette = 11=#ff9e64
palette = 12=#7da6ff
palette = 13=#bb9af7
palette = 14=#0db9d7
palette = 15=#acb0d0

# Selection color
selection-background = 7aa2f7

confirm-close-surface = false

# Treat the macOS Option key as Alt/Meta so terminal apps (tmux, nvim) receive it
macos-option-as-alt = true

# Auto-install xterm-ghostty terminfo on remote hosts over ssh, and fall back to
# TERM=xterm-256color if that fails (fixes tmux "missing or unsuitable terminal")
shell-integration-features = cursor,no-sudo,title,path,ssh-env,ssh-terminfo
